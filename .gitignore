dist/

# ─── Données : jamais sur GitHub ─────────────────────────────────────────────
# La base contient les chemins, les tags et les embeddings de 30 000 photos de
# famille. Elle se reconstruit depuis le NAS ; elle n'a rien à faire dans un
# dépôt, même privé.
# Les comptes (sels + haches PBKDF2, secret des jetons) : jamais dans un depot.
comptes.json
comptes.json.tmp
photos.db
photos.db-wal
photos.db-shm
*.db.bak
*.db.avant-*
*.snapshot.tmp
# Les bancs mesurent sur une COPIE (le serveur est l'écrivain unique) : la
# procédure produit donc un `copie.db` de 290 Mo dans le dossier. L'agent git
# le refuserait — un binaire n'est jamais négociable — mais un refus au moment
# de livrer coûte un aller-retour. Mieux vaut qu'il n'existe pas pour git.
copie.db
copie.db-wal
copie.db-shm

# ─── Le levier de la campagne de retag (chantier 2 quater) ───────────────────
# `retag_actif.txt` est de l'ETAT MACHINE, pas de la source : sa seule presence
# DEMARRE le re-tagging de tout le fonds. Le livrer dans le depot le poserait
# sur toute machine qui clone -- exactement le geste qu'on veut explicite.
retag_actif.txt

# Vignettes et découpes : dérivées, volumineuses (22 000 fichiers)
animal_thumbs/
face_thumbs/
uploads/
# Cache des vignettes /api/thumb (audit O1, 12/08) : dérivé, régénérable, et il
# croît sans borne tant que la purge O15 n'est pas faite. Oublié à sa création :
# il polluait `git status` d'un fichier par photo consultée.
photo_thumbs/

# Archive manuelle des anciens docs (ménage du 12/08) : locale, jamais versionnée.
OLD/

# Images récupérées après le crash disque : ce sont des photos personnelles
recuperees/

# Journal append-only des jugements humains de la file « À vérifier » : noms et
# chemins réels — local. Sa copie hors site = chantier « assurance-vie ».
journal_jugements.jsonl

