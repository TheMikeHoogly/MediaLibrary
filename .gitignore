# ─── Environnement Python ────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
~*/                      # dossiers orphelins laissés par une désinstallation pip

# ─── Build mono-fichier (bundle.py) ──────────────────────────────────────────
# dist/server.py est régénérable depuis server.py + ui/ par « python bundle.py ».
dist/

# ─── Données : jamais sur GitHub ─────────────────────────────────────────────
# La base contient les chemins, les tags et les embeddings de 30 000 photos de
# famille. Elle se reconstruit depuis le NAS ; elle n'a rien à faire dans un
# dépôt, même privé.
photos.db
photos.db-wal
photos.db-shm
*.db.bak
*.db.avant-*
*.snapshot.tmp

# Vignettes et découpes : dérivées, volumineuses (22 000 fichiers)
animal_thumbs/
face_thumbs/
uploads/
# Cache des vignettes /api/thumb (audit O1, 12/08) : dérivé, régénérable, et il
# croît sans borne tant que la purge O15 n'est pas faite. Oublié à sa création :
# il polluait `git status` d'un fichier par photo consultée.
photo_thumbs/

# Archive manuelle des anciens docs (ménage du 12/08) : locale, jamais versionnée.
OLD/

# Images récupérées après le crash disque : ce sont des photos personnelles
recuperees/

# Journal append-only des jugements humains de la file « À vérifier » : noms et
# chemins réels — local. Sa copie hors site = chantier « assurance-vie ».
journal_jugements.jsonl

# ─── Évaluation ──────────────────────────────────────────────────────────────
# Les DÉCISIONS sont versionnées, les données brutes non : elles contiennent
# des visages et des chemins réels.
eval/echantillon/
eval/especes/
eval/visages/
eval/illisibles/
eval/crops_res/
eval/echantillon.json
eval/especes.json
eval/visages.json
eval/illisibles.json
eval/recuperees.json
eval/animaux.json
eval/verite.json
# Banc assertions-vs-pixels : echantillon (chemins reels), resultats, et la page
# de notation (vignettes inline de photos de famille). Le PLAN .md, lui, reste.
eval/tagging_v1.json
eval/tagging_results.json
eval/rating.html
eval/rating_map.json
eval/notes.json
!eval/DECISIONS.md
!eval/PLAN_assertions_vs_pixels.md

# ─── Modèles et outils téléchargés ───────────────────────────────────────────
*.pt
exiftool-*/
# Gazetteer GeoNames pour le géocodage inverse offline : téléchargé une fois par
# « 18 - Telecharger le gazetteer (geocodage).bat », régénérable, ~13 Mo.
cities1000.txt
cities1000.zip
# Sortie du géocodage inverse : {clé_photo -> lieu}, générée par enrichir_lieux.py
# (contient des chemins réels de photos de famille) — locale, régénérable.
gps_places.json

# Proposition de commit de la session (branche + titre), écrite par Claude et
# consommée par « 27 - Commit de session.bat » : éphémère, locale.
SESSION_COMMIT.txt

