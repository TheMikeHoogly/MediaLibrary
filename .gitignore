# ─── Corbeille de fin de session (nettoyer_session.py) ───────────────────────
# Quarantaine réversible des répertoires de travail éphémères. Local, jamais
# versionné ; à vider à la main quand on est sûr.
_corbeille_session/

# ─── Corbeille du pont bureau (device_bash ne sait pas supprimer) ───────────
# Le pont vers le poste de Mike refuse `rm` : ce qui doit disparaître y est
# DÉPLACÉ, et Mike vide le dossier. Sans cette ligne, `git add -A` du bat 27
# versionnait la corbeille — deux fichiers y sont déjà entrés par ce chemin
# (`_TEST_COMPTES_10a.jpg`, `_tmp_gitread/blob_prefusion`), à détacher à la main :
#     git rm -r --cached _to_delete
_to_delete/

# ─── Quarantaine des vecteurs purgés (purger_vecteurs_orphelins.py) ─────────
# Les vecteurs sémantiques supprimés y sont écrits AVANT le DELETE (JSONL,
# vecteur en base64) : c'est la réversibilité. Local, jamais versionné ; à
# vider à la main une fois la recherche observée en réel.
_corbeille_vecteurs/

# Pilotage du serveur (arret / redemarrage commandes par fichier) : c'est un
# ETAT de la machine, pas du code. Le versionner ferait voyager un « arret »
# d'un poste a l'autre.
_commande_serveur.txt
_commande_serveur.txt.tmp
_commande_git.txt
_commande_git.txt.tmp
_etat_git.json
_etat_git.json.tmp
