# ─── Environnement Python ────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
~*/                      # dossiers orphelins laissés par une désinstallation pip

# ─── Build mono-fichier (bundle.py) ──────────────────────────────────────────
# dist/server.py est régénérable depuis server.py + ui/ par « python bundle.py ».
dist/

# ─── Données : jamais sur GitHub ─────────────────────────────────────────────
# La base contient les chemins, les tags et les embeddings de 30 000 photos de
# famille. Elle se reconstruit depuis le NAS ; elle n'a rien à faire dans un
# dépôt, même privé.
photos.db
photos.db-wal
photos.db-shm
*.db.bak
*.db.avant-*
*.snapshot.tmp

# Vignettes et découpes : dérivées, volumineuses (22 000 fichiers)
animal_thumbs/
face_thumbs/
uploads/

# Images récupérées après le crash disque : ce sont des photos personnelles
recuperees/

# ─── Évaluation ──────────────────────────────────────────────────────────────
# Les DÉCISIONS sont versionnées, les données brutes non : elles contiennent
# des visages et des chemins réels.
eval/echantillon/
eval/especes/
eval/illisibles/
eval/crops_res/
eval/echantillon.json
eval/especes.json
eval/illisibles.json
eval/recuperees.json
eval/animaux.json
eval/verite.json
# Banc assertions-vs-pixels : echantillon (chemins reels), resultats, et la page
# de notation (vignettes inline de photos de famille). Le PLAN .md, lui, reste.
eval/tagging_v1.json
eval/tagging_results.json
eval/rating.html
eval/rating_map.json
eval/notes.json
!eval/DECISIONS.md
!eval/PLAN_assertions_vs_pixels.md

# ─── Modèles et outils téléchargés ───────────────────────────────────────────
*.pt
exiftool-*/

